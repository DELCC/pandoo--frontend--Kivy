<CameraScanner>:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: 0.6
        padding: 10
        Image:
            id: camera_preview

    BoxLayout:
        orientation: 'vertical'
        size_hint_y: 0.4
        padding: 20
        spacing: 5 # Espacement réduit pour tout faire tenir
        
        # Nom du produit
        Label:
            text: app.product_name
            font_size: '22sp'
            bold: True
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None
            size_hint_y: None
            height: dp(40)

        # Valeurs nutritionnelles
        Label:
            text: app.nutrition_text
            font_size: '16sp'
            halign: 'center'
            valign: 'top'
            text_size: self.width, None
            # On laisse le reste de l'espace pour ce texte